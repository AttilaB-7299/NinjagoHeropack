{x} = min({vel}, 1){data_1}{d1}{d} / 2.5
{head_rotX} -= 10'{data_1}
{R_arm_rotX} += 8'{data_1} + 0.5abs({x})
{R_arm_rotY} += 18'{data_1}
{R_arm_rotZ} += 12'{data_1}

{L_Arm_rotX} += 8'{data_1} + 0.5abs({x})
{L_Arm_rotY} -= 18'{data_1}
{L_Arm_rotZ} -= 12'{data_1}

{R_Leg_rotX} += 15'{data_1} + 0.3{x}
{R_Leg_rotY} += 2'{data_1}
{R_Leg_rotZ} += 3'{data_1}
{L_leg_rotX} += 15'{data_1} - 0.3{x}
{L_leg_rotY} -= 2'{data_1}
{L_leg_rotZ} -= 3'{data_1}

{d} *= {data_1} / 1'
{x} = min({vel} / 2, 1) / 2
out "rotate" (-{data_1}({pitch} + 80), 1, 0, 0)
out "rotate" ({d1}{d}, 0, 1, 0)
out "rotate" (-{d1}{d}{x}, 0, 0, 1)
out "rotate" ({d}{x}, 1, 0, 0)
out "translate" (0, -0.8{data_1}, 0)
